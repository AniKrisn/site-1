# Cache's images are named by content hash, so they can cache forever —
# without this Pages serves max-age=300 and every visit re-downloads them.
/cache/img/*
  Cache-Control: public, max-age=31536000, immutable

# Hover thumbs on the home page keep their names when re-shot, so a day rather than forever.
/thumbs/*
  Cache-Control: public, max-age=86400
